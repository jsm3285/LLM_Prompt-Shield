# Prompt Shield Environment Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Upstream LLM Gateway Config
OPENAI_API_KEY=sk-demo-key-replace-with-real-key
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini

# Shield Guard Engine Config
SIMILARITY_THRESHOLD=0.78
MAX_LATENCY_BUDGET_MS=25
FAISS_INDEX_PATH=data/faiss_index.bin
ATTACK_DATASET_PATH=data/attack_vectors.json

# Security & CORS Config
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
JWT_SECRET_KEY=generate_with_secrets_token_hex
